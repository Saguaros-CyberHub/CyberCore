# Copy to credentials.auto.pkrvars.hcl and fill in.
# The real file is gitignored (*.pkrvars.hcl) -- keep it that way, it holds a
# Proxmox API token and a cleartext build password.

proxmox_url      = "https://10.0.10.10:8006/api2/json"
proxmox_username = "packer@pve!packer-token"
proxmox_token    = "REPLACE_WITH_TOKEN_SECRET"
proxmox_node     = "pve-node-0"

iso_storage_pool  = "cephfs"
disk_storage_pool = "vmpool"

vm_id         = 1698
# Proxmox validates this as a DNS name -- hyphens only, no underscores.
template_name = "kali-25-4-cloudinit-template"

# Proxmox volume ID, not a host path. The ISO must already be uploaded.
kali_iso = "cephfs:iso/kali-linux-2025.4-installer-amd64.iso"
# From the release's SHA256SUMS. "none" skips verification.
kali_iso_checksum = "none"

cores     = 4
memory    = 8192
disk_size = "64G"

network_bridge = "vmbr0"
# The build VLAN needs outbound HTTPS to http.kali.org AND a route back to the
# machine running `packer build`, which serves the preseed over HTTP.
vlan_tag = "60"

timezone = "America/Phoenix"

# Account created by the preseed and KEPT in the template. It is Packer's SSH
# user during the build and the fallback login on a clone; per-student
# credentials arrive separately through Proxmox's Cloud-Init ciuser/cipassword.
ssh_username = "kali"
# Build-time only: served over plain HTTP inside the preseed on the build VLAN.
ssh_password = "REPLACE_WITH_A_STRONG_PASSWORD"

# minimal (~4GB) | default (~12GB) | large (~25GB, +30 min)
kali_toolset = "default"
