# ============================================================================
# vars.env — bake-time configuration for the v2 lane gateway template.
# ----------------------------------------------------------------------------
# Sourced by bake.sh. Every value uses ${VAR:-default} so an environment
# variable set on the command line still wins:
#
#   FORCE=1 CYBERCORE_ORCHESTRATOR_URL=https://staging.example.org ./bake.sh
#
# These are BAKE-time settings (which CTIDs, which storage, which orchestrator
# the image defaults to). Per-deploy runtime settings live in
# files/cybercore-gateway.env.tpl, which the deploy path may overwrite inside
# an individual lane via `pct push`.
# ============================================================================

# ---------- CTIDs ----------
# Source: the proven v1 gateway template. Never modified — bake.sh clones it.
SRC_VMID=${SRC_VMID:-1692}
# Target: the v2 template this build produces.
NEW_VMID=${NEW_VMID:-1694}
# Scratch CTID the clone is patched in before it becomes the template.
TMP_VMID=${TMP_VMID:-9994}
# Scratch CTID the finished template is smoke-tested in, then destroyed.
VERIFY_VMID=${VERIFY_VMID:-9995}

# ---------- Proxmox ----------
STORAGE=${STORAGE:-vmpool}
DUMP_DIR=${DUMP_DIR:-/var/lib/vz/dump}

# Refuse to clobber an existing NEW_VMID unless this is 1.
FORCE=${FORCE:-0}

# ---------- Orchestrator URLs baked into /etc/cybercore-gateway.env ----------
# Public URL the gateway fetches its Tailscale bootstrap payload from.
# HTTPS is the default — Caddy fronts the app with Let's Encrypt certs, and
# scripts/40-install-https-tooling.sh puts a TLS-capable wget in the image.
CYBERCORE_ORCHESTRATOR_URL=${CYBERCORE_ORCHESTRATOR_URL:-https://saguaroscyberhub.org}

# Lab-internal URL the LANE uses to pull prebuilt vuln-app images. MUST match
# vuln-app-builder.js's LANE_ORCH_URL — firstboot keys its CYBERCORE-IMAGE-PULL
# iptables rule on this host, so a mismatch makes every lane's vuln-app install
# fail with exit 11.
# (front-end/modules/crucible/plugins/ciab/utils/vuln-app-builder.js:48)
CYBERCORE_INTERNAL_URL=${CYBERCORE_INTERNAL_URL:-http://100.100.20.50:80}

# ---------- Verification ----------
# Fake lane subnet the verify clone is given, to prove firstboot renders from
# whatever lan0 actually holds. Any /24 that isn't a real lane works.
VERIFY_LANE_BASE=${VERIFY_LANE_BASE:-10.99.0}

# ---------- v1 leftovers to scrub ----------
# Extended-regex alternation of addresses that only ever appear in v1 config:
# the old shared lane subnet and the legacy single Guacamole VM.
V1_PATTERNS=${V1_PATTERNS:-'192\.18\.0|100\.100\.70\.10'}
