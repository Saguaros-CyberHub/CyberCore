# Copy to credentials.auto.pkrvars.hcl and fill in.
# The real file is gitignored (*.pkrvars.hcl) -- keep it that way, it holds a
# Proxmox API token and a cleartext local admin password.

proxmox_url      = "https://10.0.10.10:8006/api2/json"
proxmox_username = "packer@pve!packer-token"
proxmox_token    = "REPLACE_WITH_TOKEN_SECRET"
proxmox_node     = "pve-node-0"

# Proxmox volume IDs, not host paths. Both ISOs must already be uploaded.
windows_iso = "local:iso/Win11_25H2_English_x64.iso"
virtio_iso  = "local:iso/virtio-win.iso"

vm_id         = 9000
template_name = "win11-cloudbase-template"

# Must match an edition in the ISO's install.wim:
#   dism /Get-WimInfo /WimFile:D:\sources\install.wim
windows_image_name = "Windows 11 Pro"

# Local admin. Used by Packer during the build and KEPT in the template --
# Sysprep does not delete local accounts. Must match `username` in
# files/cloudbase-init/*.conf so the Proxmox Cloud-Init password field drives it.
winrm_username = "cactus-user"
# Build-time only; Cloudbase-Init overwrites it on a clone's first boot.
winrm_password = "REPLACE_WITH_A_STRONG_PASSWORD"
