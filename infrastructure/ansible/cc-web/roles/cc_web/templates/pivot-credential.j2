{#
  cc_web — the pivot credential: a domain service account in an application
  configuration file.

  ONE TEMPLATE, FIVE FORMATS, AND NO CALLER-SUPPLIED BODY. A `raw` format that
  wrote a caller's file verbatim would be re-rendered by Jinja on the way
  through (see the header of tasks/content.yml), so a generated config
  containing {{ '{{' }} would either explode or, worse, evaluate. The layout is
  therefore role-owned; only the values come from the caller.

  EVERY VALUE IS ESCAPED FOR ITS FORMAT. A password with an apostrophe in it
  would otherwise produce a PHP parse error, and a password with an ampersand
  would produce XML that no parser will load — both of which turn "the
  credential is planted" into "the app's config file is corrupt", which the
  student experiences as a broken site rather than as a finding.

  Key names are generic on purpose: nothing here may identify a tenant.
#}
{% set _domain = cc_web_pivot.domain %}
{% set _user = cc_web_pivot.username %}
{% set _pass = cc_web_pivot.password %}
{% set _extra = cc_web_pivot.extra | default({}) %}
{% if cc_web_pivot.format == 'dotenv' %}
# Application environment. Generated during provisioning.
AD_DOMAIN={{ _domain }}
AD_USERNAME={{ _user }}
AD_PASSWORD={{ _pass }}
AD_AUTH_ENABLED=true
{% for key, value in _extra.items() %}
{{ key | upper | regex_replace('[^A-Z0-9_]', '_') }}={{ value }}
{% endfor %}
{% elif cc_web_pivot.format == 'php' %}
<?php
// Application configuration. Generated during provisioning.
return [
    'ad_domain'   => '{{ _domain | replace('\\', '\\\\') | replace("'", "\\'") }}',
    'ad_username' => '{{ _user | replace('\\', '\\\\') | replace("'", "\\'") }}',
    'ad_password' => '{{ _pass | replace('\\', '\\\\') | replace("'", "\\'") }}',
    'ad_auth_enabled' => true,
{% for key, value in _extra.items() %}
    '{{ key | replace('\\', '\\\\') | replace("'", "\\'") }}' => '{{ value | string | replace('\\', '\\\\') | replace("'", "\\'") }}',
{% endfor %}
];
{% elif cc_web_pivot.format == 'json' %}
{{ {'ad': {'domain': _domain, 'username': _user, 'password': _pass, 'auth_enabled': true}} | combine({'extra': _extra}) | to_nice_json }}
{% elif cc_web_pivot.format == 'ini' %}
; Application configuration. Generated during provisioning.
[directory]
domain = {{ _domain }}
username = {{ _user }}
password = {{ _pass }}
auth_enabled = true
{% if _extra %}

[application]
{% for key, value in _extra.items() %}
{{ key }} = {{ value }}
{% endfor %}
{% endif %}
{% elif cc_web_pivot.format == 'xml' %}
<?xml version="1.0" encoding="utf-8"?>
<!-- Application configuration. Generated during provisioning. -->
<configuration>
  <directory>
    <domain>{{ _domain | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}</domain>
    <username>{{ _user | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}</username>
    <password>{{ _pass | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}</password>
    <authEnabled>true</authEnabled>
  </directory>
{% for key, value in _extra.items() %}
  <setting name="{{ key | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') | replace('"', '&quot;') }}">{{ value | string | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}</setting>
{% endfor %}
</configuration>
{% else %}
{#
  UNREACHABLE, AND THAT IS THE POINT. tasks/assert.yml refuses an unsupported
  format before the host is touched. If this branch ever renders, the gate was
  bypassed — so it raises rather than writing a file that would pass a
  "the file exists" check while naming no account at all.

  The raise is an undefined variable whose NAME is the message, because that
  works on every Jinja this role might meet; undef() needs Jinja 3 and
  mandatory() only fires on something already undefined.
#}
{{ cc_web_BUG_unsupported_pivot_format_reached_the_credential_template }}
{% endif %}
