<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- FieldOps sign-in. Moved out of the database during the FY19 SQL
         consolidation (CR-1204). Rotate quarterly per IT policy. -->
    <add key="FieldOpsUser" value="d.mercer" />
    <add key="FieldOpsPassword" value="CopperRidge#2019" />
    <add key="AttachmentRoot" value="~/Uploads" />
    <add key="DispatchContact" value="dispatch@copperridge.local" />
    <add key="SiteCode" value="PIT4" />
  </appSettings>

  <connectionStrings>
    <!-- RETIRED FY19 - instance decommissioned, see CR-1204 -->
    <add name="FieldOpsDb"
         connectionString="Server=TUC-SQL01;Database=FieldOps;User Id=svc_fieldops;Password=Cr8sher!Line2;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <!-- debug left on after the CR-1402 upload troubleshooting -->
    <compilation debug="true" targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" maxRequestLength="4096" requestValidationMode="2.0" />
    <customErrors mode="Off" />
    <sessionState mode="InProc" timeout="60" />
    <pages validateRequest="false" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Added so Dispatch can read the nightly config dump in a browser
           instead of RDPing to the box. (t.brandt, CR-3318) -->
      <mimeMap fileExtension=".bak" mimeType="text/plain" />
    </staticContent>
  </system.webServer>

  <!-- Nightly configuration dump. Reviewed after a change window. -->
  <location path="backup">
    <system.webServer>
      <directoryBrowse enabled="true" />
    </system.webServer>
  </location>

</configuration>
