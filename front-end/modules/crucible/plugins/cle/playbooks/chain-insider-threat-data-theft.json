      "oneOf": [
        "jsmith",
        "mrodriguez",
        "kchen",
        "apatel",
        "dwilson",
        "tnguyen"
      ]
    },
    "target": "fileserv-01",
    "c2": {
      "ipv4Host": "203.0.113"
