      "metadata": {
        "event_action": "file-read",
        "user": "{{user}}"
      }
    },
    {
      "gap": "90s",
      "spread": "150s",
      "count": 40,
      "level": "INFO",
      "technique": "T1213",
      "tactic": "TA0009",
      "source": {
        "type": "database",
        "name": "postgres-primary",
        "host": "db-01"
      },
      "message": "duration: {{rand:800-5000}}ms  statement: SELECT * FROM customers LIMIT 10000 OFFSET {{rand:0-90000}}",
      "metadata": {
        "event_action": "query",
        "user": "{{user}}"
      }
    },
    {
      "gap": "120s",
      "spread": "180s",
      "count": 36,
      "level": "WARN",
      "technique": "T1020",
      "tactic": "TA0010",
      "source": {
        "type": "firewall",
        "name": "iptables",
        "host": "{{fw}}"
      },
      "message": "ACCEPT OUT=eth1 SRC={{target}} DST={{c2}} PROTO=TCP DPT=443 bytes={{rand:4800000-5300000}}",
      "metadata": {
        "event_action": "connection-allowed",
        "dst_ip": "{{c2}}"
      }
    },
    {
      "gap": "90s",
      "spread": "60s",
      "count": 10,
      "level": "WARN",
      "technique": "T1070.004",
      "tactic": "TA0005",
      "source": {
        "type": "host",
        "name": "bash",
        "host": "{{target}}"
      },
      "message": "pid={{pid}} uid=1000 user={{user}} cmd=shred -u /tmp/.cache/part-{{rand:1-40}}",
      "metadata": {
        "event_action": "process-start",
        "user": "{{user}}"
      }
    }
