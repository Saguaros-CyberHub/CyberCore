        "event_action": "process-start",
        "user": "{{user}}"
      }
    },
    {
      "gap": "120s",
      "spread": "120s",
      "count": 60,
      "level": "INFO",
      "technique": "T1005",
      "tactic": "TA0009",
      "source": {
        "type": "host",
        "name": "auditd",
