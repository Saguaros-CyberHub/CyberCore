{
  "technique": "T1499",
  "tactic": "TA0040",
  "name": "Endpoint Denial of Service",
  "story": "A short, very high volume flood against one web host.",
  "nominal_seconds": 300,
  "entities": {
    "target": "web-01",
    "fw": "firewall-01"
  },
  "pools": {
    "paths": [
      "/",
      "/login",
      "/api/search",
      "/api/reports",
      "/checkout"
    ],
    "agents": [
      "Mozilla/5.0 (X11; Linux x86_64) Gecko/20100101 Firefox/128.0",
      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/127.0.0.0 Safari/537.36",
      "curl/8.6.0"
    ]
  },
  "steps": [
    {
      "gap": "30s",
      "spread": "60s",
      "count": 600,
      "level": "WARN",
      "source": {
        "type": "webserver",
        "name": "nginx-proxy",
        "host": "{{target}}"
      },
      "message": "10.{{rand:1-254}}.{{rand:1-254}}.{{rand:1-254}} - - \"GET {{paths}} HTTP/1.1\" 503 0 \"-\" \"{{agents}}\"",
      "metadata": {
        "event_action": "http-request",
        "status": "503"
      }
    },
    {
      "gap": "5s",
      "spread": "40s",
      "count": 60,
      "level": "ERROR",
      "source": {
        "type": "server",
        "name": "nginx",
        "host": "{{target}}"
      },
      "message": "worker_connections are not enough while connecting to upstream, {{rand:900-4000}} pending",
      "metadata": {
        "event_action": "error"
      }
    },
    {
      "gap": "5s",
      "spread": "30s",
      "count": 24,
      "level": "WARN",
      "source": {
        "type": "firewall",
        "name": "iptables",
        "host": "{{fw}}"
      },
      "message": "DROP IN=eth0 OUT=eth1 SRC=10.{{rand:1-254}}.{{rand:1-254}}.{{rand:1-254}} DST={{target}} LEN={{rand:44-1500}} TOS=0x00 PREC=0x00 TTL={{rand:52-64}} ID={{rand:1-65535}} DF PROTO=TCP SPT={{port}} DPT=443 WINDOW={{rand:501-65535}} RES=0x00 SYN URGP=0",
      "metadata": {
        "event_action": "rate-limit"
      }
    }
  ]
}
