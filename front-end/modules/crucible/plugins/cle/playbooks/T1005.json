{
  "technique": "T1005",
  "tactic": "TA0009",
  "name": "Data from Local System",
  "story": "Local files are enumerated, read and staged into a single archive.",
  "nominal_seconds": 300,
  "entities": {
    "target": "fileserv-01",
    "user": {
      "oneOf": [
        "jsmith",
        "mrodriguez",
        "kchen",
        "apatel",
        "dwilson",
        "tnguyen"
      ]
    },
    "stage": "/tmp/.cache"
  },
  "pools": {
    "dirs": [
      "/home/shared/finance",
      "/home/shared/hr",
      "/srv/contracts",
      "/var/backups"
    ],
    "files": [
      "q3-forecast.xlsx",
      "payroll-2026.csv",
      "msa-signed.pdf",
      "passwords.kdbx",
      "board-minutes.docx",
      "customer-export.csv"
    ]
  },
  "steps": [
    {
      "gap": "20s",
      "spread": "20s",
      "count": 6,
      "level": "INFO",
      "source": {
        "type": "host",
        "name": "bash",
        "host": "{{target}}"
      },
      "message": "pid={{pid}} uid=1000 user={{user}} cmd=find {{dirs}} -type f -size +100k",
      "metadata": {
        "event_action": "process-start",
        "user": "{{user}}"
      }
    },
    {
      "gap": "10s",
      "spread": "60s",
      "count": 48,
      "level": "INFO",
      "source": {
        "type": "host",
        "name": "auditd",
        "host": "{{target}}"
      },
      "message": "type=PATH item=0 name=\"{{dirs}}/{{files}}\" inode={{rand:100000-999999}} dev=fd:00 mode=0100644 ouid=1000 ogid=1000 rdev=00:00 nametype=NORMAL auid=1000 key=\"file-read\"",
      "metadata": {
        "event_action": "file-read",
        "user": "{{user}}",
        "path": "{{dirs}}/{{files}}"
      }
    },
    {
      "gap": "10s",
      "spread": "15s",
      "count": 1,
      "level": "WARN",
      "source": {
        "type": "host",
        "name": "bash",
        "host": "{{target}}"
      },
      "message": "pid={{pid}} uid=1000 user={{user}} cmd=tar -czf {{stage}}/a.tgz {{dirs}}",
      "metadata": {
        "event_action": "process-start",
        "user": "{{user}}",
        "path": "{{stage}}/a.tgz"
      }
    },
    {
      "gap": "10s",
      "spread": "20s",
      "count": 4,
      "level": "WARN",
      "source": {
        "type": "host",
        "name": "auditd",
        "host": "{{target}}"
      },
      "message": "type=PATH item=0 name=\"{{stage}}/a.tgz\" inode={{rand:100000-999999}} dev=fd:00 mode=0100600 ouid=1000 ogid=1000 rdev=00:00 nametype=CREATE auid=1000 key=\"file-write\"",
      "metadata": {
        "event_action": "file-write",
        "user": "{{user}}",
        "path": "{{stage}}/a.tgz"
      }
    }
  ]
}
