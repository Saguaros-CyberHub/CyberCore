# ============================================================================
# CYBERHUB — Production Environment Configuration
# Copy to .env and fill in values
# ============================================================================
#
# Every REPLACE_ME must be replaced before going to production. Generate
# secrets with: openssl rand -hex 32
#
# DUPLICATE KEYS SILENTLY WIN: dotenv keeps the LAST occurrence of a key, with
# no warning. If you paste a block twice, the second copy overrides the first —
# including overriding a real secret with a REPLACE_ME placeholder. Check with:
#   grep -oP '^[A-Z0-9_]+(?==)' .env | sort | uniq -d
# ============================================================================

TZ=America/Phoenix

# Reverse Proxy / Public hostname
# Set to your domain for automatic HTTPS (Let's Encrypt via Caddy).
# Set to :80 for HTTP-only LAN/offline mode. See docs/offline-mode.md.
CYBERHUB_HOST=yourdomain.example.edu

# First admin account seeded at database init time
ADMIN_EMAIL=admin@yourdomain.example.edu

# ============================================================================
# DATABASES
# ============================================================================
# Core Database (cybercore_db — single source of truth: users, lanes, modules,
# email outbox, activation tokens)
CORE_DB_USER=cyberhub
CORE_DB_PASSWORD=REPLACE_ME
CORE_DB_NAME=cybercore_db
CORE_ENABLED_MODULES=crucible,cyberlabs,forge,library,university,wiki

# CIAB clinic database (clinic_db — activity log, CIAB plugin tables).
# DB_HOST is the compose service name; it is not reachable from the host.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=clinic_db
DB_USER=cyberhub
DB_PASSWORD=REPLACE_ME

# ============================================================================
# AI / LLM
# ============================================================================
# Anthropic API key for CIAB vuln-app, profile, interview, policy and document
# generation. It no longer gates the global AI assistant — see
# AI_ASSISTANT_ENABLED below.
ANTHROPIC_API_KEY=REPLACE_ME

# The floating AI assistant in the bottom-right corner of every page. OFF
# unless this reads exactly "true".
#
# BOTH this and ANTHROPIC_API_KEY are required: this one is intent, the key is
# capability, and a launcher with no key just fails on every send. With the
# assistant off, GET /api/chat/status reports enabled:false — which hides the
# launcher (layout.js injectGlobalChat) AND drops the "AI Assistant" sidebar
# entry (layout.js visibleItems) — and POST /api/chat answers 404.
#
# Turning it off does NOT disturb any other AI feature: profile generation,
# the interview simulator, policy generation and the vuln-app builder all go
# through the same key and keep working.
AI_ASSISTANT_ENABLED=false

# The default model for any flow that does not pin its own. Profile generation
# runs on this; the vuln-app builder pins Opus 5 (CIAB_VULN_APP_MODEL) and the
# interview simulator pins Haiku 4.5 (CIAB_INTERVIEW_MODEL).
#
# NOTE: Sonnet 5, Opus 5, Opus 4.7 and 4.8 REMOVED sampling parameters —
# temperature/top_p/top_k return HTTP 400, they are not ignored. llm-client
# drops them for those models (MODELS_WITHOUT_SAMPLING_PARAMS), so the
# generator's temperature field only bites on Haiku 4.5. Profile variety on the
# newer models comes from the per-run seed and the prompt's flavour anchors.
# Setting this to a superseded id still works — llm-client forwards it to the
# current model of the same tier and logs that it did.
LLM_DEFAULT_MODEL=claude-sonnet-5
LLM_DEFAULT_MAX_TOKENS=8192
# Requests above this max_tokens are STREAMED. Current models allow up to 128K
# output tokens, but a non-streaming request has to finish inside one HTTP
# response and long generations hit the SDK timeout first. Small calls
# (interview 256, chat 768) are unaffected.
LLM_STREAM_ABOVE_TOKENS=16000

# Vuln-app generation — the most demanding thing CIAB asks a model to do.
# CIAB_VULN_APP_MODEL             default claude-opus-5
# CIAB_VULN_APP_EFFORT            default xhigh (low|medium|high|xhigh|max)
# CIAB_VULN_APP_FILE_MAX_TOKENS   default 32768 per generated file
# CIAB_VULN_APP_FILE_RETRY_MAX_TOKENS  default 65536 on a truncation retry
# CIAB_VULN_APP_FILE_CONCURRENCY  default 2 — the throughput lever. Nothing
#   records this org's rate-limit tier, so 2 is conservative, not measured.
#   Raise it and watch for 429s; it multiplies with the per-file ceiling.
# CIAB_INTERVIEW_MODEL            default claude-haiku-4-5
LLM_TIMEOUT_MS=600000
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENT=10

# Per-file fan-out when generating a vulnerable app.
CIAB_VULN_APP_FILE_CONCURRENCY=5
CIAB_VULN_APP_FILE_MAX_TOKENS=8192

# ============================================================================
# TAILSCALE
# ============================================================================
# OAuth client for programmatic node registration. NOTE: the lab uses
# 100.100.0.0/16, which sits inside Tailscale's CGNAT range — kernel-mode nodes
# need a wan0 carve-out or ts-input drops lab traffic.
TAILSCALE_OAUTH_CLIENT_ID=REPLACE_ME
TAILSCALE_OAUTH_CLIENT_SECRET=REPLACE_ME
TAILSCALE_TAILNET=you@example.com

# ============================================================================
# APP SECURITY
# ============================================================================
JWT_SECRET=REPLACE_ME
SESSION_SECRET=REPLACE_ME
# Required in production: HMAC key for /vuln-assets signed download URLs.
# The app refuses to start signing with the dev fallback when NODE_ENV=production.
VULN_ASSETS_SECRET=REPLACE_ME

# Marks the session cookie Secure — the browser then returns it ONLY over https.
# true is the default and is correct for every public deployment of this stack:
# traffic arrives through the Cloudflare tunnel, which terminates TLS at the
# edge, so the BROWSER sees https on every public request no matter what the
# hop from cloudflared to caddy looks like.
#
# SET IT false FOR EXACTLY ONE CASE: a HUMAN browsing the app over plain http://,
# by raw lab IP or bare hostname, against the `http://:80` site block in
# config/caddy/Caddyfile. That listener exists for lane gateways and lane VMs,
# and those are MACHINE callers carrying bearer tokens and signed token URLs —
# they hold no cookie session, so a Secure cookie is invisible to them. A person
# on that same path is the trap: the browser quietly declines to send a Secure
# cookie back over http, so the login POST succeeds with a 200, the redirect
# bounces straight back to /login, and there is nothing in any log to explain it
# because nothing errored. If your operators sign in over http://<lab-ip>, set
# this to false and accept that the session cookie then crosses that network in
# clear text.
#
# Compared as a string (=== 'true' in src/routes/auth.js sessionCookieOptions()),
# so anything that is not exactly "true" is false. See COOKIE_DOMAIN further
# down for the other half of the cookie story.
COOKIE_SECURE=true

# ============================================================================
# DEPLOYMENT
# ============================================================================
# Ceiling on simultaneous lane deploys.
MAX_CONCURRENT_DEPLOYS=100

# Where lane VMs reach the orchestrator to pull vuln-app images. Must be an
# address reachable FROM the lab network, not from the host.
ORCHESTRATOR_PUBLIC_URL=http://100.100.20.50:80

# ============================================================================
# APACHE GUACAMOLE
# ============================================================================
# Service account used by the CyberCore backend to call the Guacamole API.
# Never exposed to the browser.
GUAC_ADMIN_USER=guacadmin
GUAC_ADMIN_PASSWORD=REPLACE_ME

# Guacamole PostgreSQL database (hosted on the shared postgres container).
GUAC_DB_NAME=guacamole_db
GUAC_DB_USER=guacamole_user
GUAC_DB_PASSWORD=REPLACE_ME
# Encrypts stored connection credentials. openssl rand -hex 32
GUAC_ENCRYPT_KEY=REPLACE_ME

# Only set GUAC_API_URL to override the in-compose Guacamole. GUAC_ENABLED and
# GUAC_PUBLIC_BASE_URL are set automatically in docker-compose.yml.
#GUAC_API_URL=http://100.100.70.10:8080/guacamole

# Encrypts TOTP/MFA secrets at rest (pgcrypto). openssl rand -hex 32
# If unset, falls back to GUAC_ENCRYPT_KEY.
MFA_ENCRYPT_KEY=REPLACE_ME

# ---------------------------------------------------------------------------
# Lab infrastructure hidden from the student it is allocated to
# ---------------------------------------------------------------------------
# A lane can hold a machine the student works ON and a machine the exercise
# merely NEEDS — the CYBR 400 telemetry sensor being the case this exists for.
# Both are allocated to the student, so without this both draw a card with an
# Open Console button and students log into the log-generator their own
# detection exercise depends on.
#
# A deployed machine is hidden when its catalog template carries one of these
# role_hints, when its template_key matches CYBR400_LOGGEN_TEMPLATE_KEY below,
# or when its cybercore_resource.metadata.student_hidden is the string 'true'
# (the per-VM override, for a machine the two rules above cannot see). Hidden
# means: absent from GET /api/dashboard/vms, refused by the console-launch and
# credential routes, and not granted the owner READ in Guacamole. Instructors
# and admins are never filtered and see a "Hidden from student" badge instead.
#
# Comma-separated. Leave unset for the default, 'loggen'. Set it to an empty
# value to turn the rule off and leave only the per-VM override. Do NOT add
# 'elk' or 'wazuh' — the SIEMs are where students do the work.
#WORKSPACE_HIDDEN_ROLE_HINTS=loggen

# Pins the sensor image by name for a site that has not tagged its catalog
# (role_hints has no admin UI, so untagged is the normal first-time state).
# Read by the incident engine's target resolution AND by the hiding rule above,
# deliberately the same variable — two names for one image is how the engine
# ends up aiming at one machine while the platform hides another.
#CYBR400_LOGGEN_TEMPLATE_KEY=cybr400-loggen-template

# ============================================================================
# PGADMIN / ADMINER / FTP
# ============================================================================
PGADMIN_EMAIL=admin@cybercore.local
PGADMIN_PASSWORD=REPLACE_ME

FTP_USER=cybercore
FTP_PASSWORD=REPLACE_ME

# ============================================================================
# PROXMOX
# ============================================================================
PROXMOX_API_URL=https://100.100.10.10:8006
PROXMOX_TOKEN_ID=root@pam!clinic-app-token
PROXMOX_TOKEN_SECRET=REPLACE_ME

# Proxmox SSH — REQUIRED for working lane consoles.
#
# The API cannot exec inside an LXC, so anything that has to run a shell in a
# lane gateway goes over ssh to the node and then `pct exec`. That covers the
# per-lane DHCP reservations and console DNAT rules, which is to say: without
# this, a lane deploys and reports active but its workstation takes a random
# pool lease and its console never connects.
#
# PROXMOX_SSH_KEY is the path INSIDE the container. docker-compose mounts
# ${PROXMOX_SSH_KEY_HOST} there read-only, so set that to the private key on the
# host whose public half is in root's authorized_keys on every node. The key
# must have no passphrase (BatchMode=yes — nothing can answer a prompt).
#
#   ssh-keygen -t ed25519 -N '' -f ./secrets/proxmox_ed25519
#   for n in 10 11 12 13 14 15; do ssh-copy-id -i ./secrets/proxmox_ed25519.pub root@100.100.10.$n; done
#
# Node NAMES are resolved to IPs through config/site.json's
# cluster.physical_cluster_details, so the container does not need DNS for them.
PROXMOX_SSH_USER=root
PROXMOX_SSH_KEY=/run/secrets/proxmox_ssh_key
PROXMOX_SSH_KEY_HOST=./secrets/proxmox_ed25519

# ============================================================================
# RATE LIMITING
# ============================================================================
# Per-user (non-admin) request cap within the window below. High-frequency read
# endpoints (auth status check, status polls) are exempt in server.js, so this
# governs genuine API activity. Raise if active users still trip it.
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_WINDOW_MS=900000

# ============================================================================
# EMAIL
# ============================================================================
# Used by the CLE roster import: activation links for newly created student
# accounts, "you've been added to <course>" notices for existing ones, and
# temporary-password notices when staff regenerate a credential.
#
# Everything below is optional. With MAIL_ENABLED=false the platform works
# exactly as before — every message is RECORDED as suppressed and the roster
# import shows the instructor the credentials to distribute by hand instead.
# That is a legitimate way to run this (and the only way on an isolated LAN),
# not a degraded mode.
MAIL_ENABLED=false
MAIL_HOST=mailrelay
# 587 (submission), NOT 25. The bundled boky/postfix relay binds submission only
# — `docker compose ps mailrelay` reports "587/tcp" and nothing is listening on
# 25 — so pointing the app at 25 does not fail fast, it hangs until nodemailer's
# connection timeout and reports a bare timeout with no clue as to why.
# 587 is also correct for every external option documented below.
MAIL_PORT=587
# false at 587: submission upgrades in-band via STARTTLS. `true` is for implicit
# TLS on 465 only, and setting it here makes the handshake fail.
MAIL_SECURE=false
MAIL_FROM=CyberHub <no-reply@yourdomain.example.edu>
MAIL_REPLY_TO=

# Submission credentials. Leave both empty for the bundled `mailrelay` service —
# it has no published port and only listens on cybercore-net, so submission is
# unauthenticated by design. Set them to point MAIL_HOST straight at an external
# relay instead, skipping the Postfix container entirely:
#
#   Resend    MAIL_HOST=smtp.resend.com  MAIL_PORT=587  MAIL_USER=resend
#             MAIL_PASSWORD=<api key>    (the username really is the word "resend")
#             If 587 times out rather than refusing, outbound submission is
#             filtered on your network. Resend also listens on 2587 (STARTTLS,
#             MAIL_SECURE=false) and 2465 (implicit TLS, MAIL_SECURE=true) for
#             exactly that case — try those before rebuilding the topology.
#   SES       MAIL_HOST=email-smtp.<region>.amazonaws.com  MAIL_PORT=587
#   Gmail     MAIL_HOST=smtp.gmail.com   MAIL_PORT=587  MAIL_USER=<address>
#             MAIL_PASSWORD=<16-char app password, needs 2FA on the account>
#
# Bypassing Postfix also sidesteps the outbound-port-25 problem below, which is
# usually the fastest way to working mail on a residential or campus IP.
MAIL_USER=
MAIL_PASSWORD=

# Certificate verification is REQUIRED for any host that is not the bundled
# relay — an external submission host is handed MAIL_PASSWORD over the internet,
# so an unverified certificate there is credential interception, not a
# convenience. Single-label names (`mailrelay`), localhost and RFC 1918 literals
# are treated as internal and exempt automatically. Set this only for the rare
# self-signed relay reached by FQDN; it must be exactly "true".
MAIL_TLS_INSECURE=

# Absolute, externally reachable base URL. Activation links are built from it,
# so if this points at something students cannot reach, every invitation is a
# dead link. No trailing slash.
MAIL_PUBLIC_URL=https://yourdomain.example.edu

# pgcrypto key for message bodies at rest — bodies carry activation links,
# which are live credentials until redeemed. Falls back to MFA_ENCRYPT_KEY then
# GUAC_ENCRYPT_KEY; with none of the three set, every message is suppressed
# rather than stored in plaintext.
#   openssl rand -hex 32
MAIL_ENCRYPT_KEY=REPLACE_ME

MAIL_POLL_MS=15000
MAIL_MAX_ATTEMPTS=5
MAIL_RETENTION_DAYS=30
# Sending burst rate is itself a deliverability signal, independent of SPF/DKIM.
MAIL_RATE_PER_MIN=60

# Comma-separated. Empty means "send anywhere" — set this to your institution's
# domain(s) so a mistyped or malicious roster cannot turn the platform into a
# branded credential-phishing sender. Blocked recipients are recorded and shown
# in the import results, never silently dropped.
#   MAIL_ALLOWED_RECIPIENT_DOMAINS=arizona.edu,email.arizona.edu
MAIL_ALLOWED_RECIPIENT_DOMAINS=

# Self-service account creation at /register. OFF unless this is exactly "true".
#
# Accounts on this platform come from a roster: an instructor imports a class and
# every student is invited by email. An open /register alongside that lets anyone
# on the internet obtain a login to a cyber range, and the accounts it makes have
# no provenance — provisioned_via is NULL, so no instructor can manage them and
# they belong to no course.
#
# Turning this off does NOT strand anyone. Existing accounts are unaffected, and
# POST /api/auth/password/request still mails a fresh link to anyone who was ever
# invited, so a student who lost or never opened their invitation recovers without
# an instructor.
ALLOW_SELF_REGISTRATION=false

# How long an activation link stays valid. 336h = 14 days: students on an async
# course first open their mail on very different days, and a window shorter than
# the first week of term turns into a queue of manual resend requests for the
# instructor. The link is single-use and a resend revokes the previous one, so a
# longer window does not accumulate live links.
ACTIVATION_TTL_HOURS=336

# How long a temporary password stays valid. This is the fallback credential:
# the one shown to an instructor when an invitation could not be emailed, and
# the one a staff regenerate hands out. It is read aloud, written down, or left
# sitting in a mailbox, so it is bounded the same way the link it replaced was —
# an unbounded one stays valid for the rest of the term if the student simply
# never signs in. Expired temp passwords are refused at login with a message
# telling the student to ask for a new one.
TEMP_PASSWORD_TTL_HOURS=72

# Synthetic domain for generated cohort accounts (CYBR-480-7W1-1-student1 etc).
# Those credentials are handed out on a printed sheet, never emailed, and the
# mailer hard-suppresses this domain regardless of any other setting. It MUST
# NOT be a domain you actually own — .invalid is reserved for exactly this.
CLE_COHORT_EMAIL_DOMAIN=cohort.invalid

# ---------------------------------------------------------------------------
# Mail relay container (the `mailrelay` service)
# ---------------------------------------------------------------------------
# Only relevant when MAIL_HOST=mailrelay. If you point MAIL_HOST at an external
# relay (Resend, SES, Gmail), everything in this block is unused — the app
# never touches the Postfix container.
#
# MAIL_RELAY_HOSTNAME MUST equal the PTR (reverse DNS) record of the public IP
# this container's mail egresses from. Only the IP's owner — ISP, campus netops,
# cloud provider — can set a PTR, and a generic one is rejected outright by
# Gmail and Outlook. Residential IPs generally cannot get one at all.
MAIL_RELAY_HOSTNAME=mail.yourdomain.example.edu
MAIL_RELAY_ALLOWED_SENDER_DOMAINS=yourdomain.example.edu
MAIL_DKIM_SELECTOR=cyberhub

# STRONGLY RECOMMENDED if you keep the Postfix relay. Hand off to a reputable
# relay — ideally the institution's own SMTP server — instead of delivering
# direct to MX. A new IP sending 200 near-identical credential-bearing messages
# in one burst is the textbook spam signature, and will be spam-foldered even
# with SPF, DKIM, DMARC and PTR all correct. Leave empty to attempt direct
# delivery. boky/postfix expects the [host]:port form.
MAIL_SMARTHOST=
MAIL_SMARTHOST_USER=
MAIL_SMARTHOST_PASSWORD=

# Cloudflare Tunnel — outbound-only ingress. Required because the upstream
# school NAT drops inbound handshakes under load. Get this from the Cloudflare
# Zero Trust dashboard: Networks -> Tunnels -> your tunnel -> Install connector.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Caldera AUTHORING console (the `caldera` service)
# ---------------------------------------------------------------------------
# ONE instance, platform-wide. No agents, no agent contact, executes nothing —
# instructors use its web UI to BUILD adversaries and CyberCore replicates one
# into a lane's own lane-local Caldera at launch. The per-lane EXECUTOR
# Calderas are still Proxmox VMs and are configured nowhere in this file.
#
# It publishes NO host ports, so the only route to it is Caddy's /caldera*
# handle, which runs forward_auth against the app first.
#
# REQUIRED, NO DEFAULT, BOTH SIDES FAIL CLOSED WITHOUT IT. This is the HMAC key
# for the single-use SSO token: the app mints it and the container verifies it,
# so the SAME value reaches both services from this one line. Unset or shorter
# than 32 bytes and the app refuses to mint (forward_auth then denies) and the
# container refuses to start. There is deliberately no fallback — a default
# signing key in a repository is worse than no signing, because it looks signed.
#   openssl rand -hex 32
CALDERA_SSO_SECRET=

# The hostname the authoring console is served on. It needs its OWN hostname,
# not a path on the main site: magma is a single-page app that bootstraps from
# GET /api/v2/config/main at the origin root, so a subpath mount cannot work.
#
# Point a Cloudflare tunnel ingress rule for this hostname at the caddy service.
# The session cookie is HOST-ONLY unless this is set, so a login on the main
# site is NOT sent to caldera.<domain> and the console's forward_auth gate
# answers 401. Set it to the PARENT domain, with the leading dot, to share the
# session across subdomains:
#
#     COOKIE_DOMAIN=.example.edu
#
# THE TRADE: every subdomain of that parent can then read the session cookie.
# Fine when one operator controls them all; NOT fine if any subdomain is
# delegated elsewhere or serves untrusted content. Leave empty to keep the
# host-only default.
COOKIE_DOMAIN=

# BOTH the caddy service AND the app service are given this value from this one
# entry (docker-compose.yml names it twice on purpose). Caddy opens the console's
# two site blocks on it; the app answers GET /api/caldera-authoring/status with
# it, which is the ONLY thing that decides whether either instructor surface
# offers the link at all. Give it to Caddy alone and the console works perfectly
# while every instructor is told "attack authoring is not set up" — nothing
# errors, nothing is logged, and the console stays undiscoverable.
CALDERA_HOST=caldera.example.edu

# Where CADDY DIALS, container to container on cybercore-net — NOT where a
# browser goes, and never rendered as a link. The compose service name; change it
# only if you front a separate authoring host.
CALDERA_AUTHORING_UPSTREAM=caldera:8888

# The nonce-burn endpoint that makes the token SINGLE USE. The container has no
# Redis of its own, so the burn happens server-side in CyberCore. Keep this on
# the internal network (the `app` service name) — it must not leave the compose
# bridge, and it must not go out via the public hostname.
CYBERCORE_REDEEM_URL=http://app:3000/api/caldera/redeem

# Caldera release tag to build. Bumping it rebuilds the image:
#   docker compose build caldera && docker compose up -d caldera
CALDERA_VERSION=5.3.0

# REQUIRED. This block used to say OPTIONAL; the code moved and this line did
# not. CALDERA_API_KEY_RED is the credential that actually authenticates the
# console — Caddy injects it as Caldera's `KEY` header on every proxied request
# and auth_svc.check_permissions() short-circuits on it for every route — so the
# entrypoint now REFUSES TO START when it is unset or shorter than 32 characters
# (infrastructure/caldera/entrypoint.sh). An ephemeral key would leave Caddy
# presenting one the container has never heard of, and every request would fall
# through to Caldera's own login form, which accepts no password.
#   openssl rand -hex 32
CALDERA_API_KEY_RED=

# Still genuinely optional — nothing presents a blue key. Empty = the entrypoint
# generates an ephemeral one per start, which is harmless.
CALDERA_API_KEY_BLUE=

# CALDERA_AUTHORING_API_KEY IS THE SAME SECRET, SEEN FROM THE APP'S SIDE, and
# you do not set it here: docker-compose.yml passes CALDERA_API_KEY_RED straight
# through to the `app` service under that name, so there is one value to manage
# and no way to set half of it.
#
# It exists because src/incident/caldera/authoring.js calls the v2 API to read an
# authored adversary back out, and needs its own key to do that. With no key it
# does not error — resolveApiKey() reports 'not_set' and the surface renders
# "not configured" — so a missing key costs a feature quietly rather than
# raising anything.
#
# THE TWO MUST STAY IDENTICAL, and a mismatch is quiet in the same way: the
# console keeps working (that path uses Caddy's copy of the key) while every API
# call the app makes comes back 401.
#
# WITH A SECRET STORE, prefer the file form. Set CALDERA_AUTHORING_API_KEY_FILE
# on the app service to a root-owned 0600 path holding the same value; it wins
# over the inline variable and is re-read per call, so rotating the file takes
# effect on the next click instead of the next restart. Mind the trailing
# newline `echo` leaves — the reader trims, but a key with one would 401 exactly
# like a wrong key.

# OPTIONAL. Encrypt Caldera's on-disk object store. Leave empty and the
# entrypoint generates them ONCE and keeps them inside the named data volume,
# which is what makes authored content survive a restart. Set them only to hold
# them in your own secret store — and note that CHANGING them orphans every
# object already written to that volume.
CALDERA_ENCRYPTION_KEY=
CALDERA_CRYPT_SALT=
