# =============================================================================
# CyberHub — Caddy Reverse Proxy
# =============================================================================
# CYBERHUB_HOST controls the public site:
#
#   yourdomain.example.edu   — HTTPS with automatic Let's Encrypt certificate
#   :80                      — HTTP only, no certificate (offline / LAN mode)
#
# A SECOND, internal-only HTTP listener on :80 is always defined below so that
# in-cluster clients (lane gateways, GOAD controllers, anything calling
# /api/lane-bootstrap from inside the lab) can reach the app over plain HTTP
# without dealing with TLS handshakes against the public Let's Encrypt cert.
# This avoids:
#   - BusyBox wget on Alpine LXCs failing the public-cert handshake
#   - Hairpin-NAT routing problems when an internal host resolves the public
#     hostname to a public IP and the lab edge router doesn't NAT back in
#
# Reachability of the internal :80 listener is gated at the network layer by
# OPNsense firewall rules (only lab subnets and the orchestrator's own
# interface), so it isn't exposed to the public internet.
# =============================================================================

# --- Global options ---------------------------------------------------------
# Disable Caddy's automatic HTTP→HTTPS redirect. Caddy keeps managing TLS for
# {$CYBERHUB_HOST} (HTTPS still works on :443), but it stops emitting 308
# redirects for *every* :80 request — which was bouncing lane VM image pulls
# to https://<ip> where the cert doesn't match and the lane has no LE root.
# If you want to restore HTTP→HTTPS for the public site only, add an explicit
# `http://yourdomain { redir https://{host}{uri} }` block.
{
    auto_https disable_redirects
    # Reverse-proxy errors include the original URI even without access logs.
    # Redact agent capabilities from Caddy's default runtime/error logger too.
    log {
        format filter {
            wrap json
            fields {
                request>uri regexp /agent/[0-9a-f]{64} /agent/REDACTED
                request>headers>X-Forwarded-Uri delete
            }
        }
    }
}

# --- The Caldera gate, defined ONCE ------------------------------------------
# Imported by every site block that serves the authoring console. It is a
# snippet rather than copy-pasted lines because forgetting one line of it
# publishes an adversary authoring console to the internet behind nothing but
# Caldera's own login form — and a copy-paste is exactly how that happens.
# front-end/test/caldera-container-config.test.js asserts that every block
# reaching the Caldera upstream imports this.
#
# `route` IS LOAD-BEARING. Outside it, Caddy sorts directives into its own
# order, in which request_header runs AFTER forward_auth — the strips below
# would then delete the header the gate had just installed. Inside `route`,
# execution order is written order. Do not unwrap it.
(caldera_gate) {
    route {
        # Delete anything the CLIENT sent under a name we trust. KEY is the one
        # that matters: it is Caldera's own api-key header and the credential
        # that actually authenticates the proxied request, so a caller allowed
        # to supply their own would bypass the gate entirely and authenticate
        # to Caldera directly. The rest close Caddy advisory
        # GHSA-7r4p-vjf4-gxv4, where copy_headers does NOT remove a
        # client-supplied header if the auth response omits it.
        request_header -KEY
        request_header -X-CyberCore-Auth
        request_header -X-CyberCore-User
        request_header -X-CyberCore-Role
        request_header -Remote-User
        request_header -Remote-Groups
        request_header -Remote-Email
        request_header -Remote-Name

        # FAIL CLOSED. If app:3000 is down or answers anything outside 2xx,
        # Caddy returns 502 and does NOT proxy. forward_auth has no
        # allow-on-failure path. The app answers 204 for an instructor or admin,
        # 401 for anonymous, 403 for anyone else, all with an empty body.
        forward_auth app:3000 {
            uri /api/caldera-authoring/authorize
            copy_headers X-CyberCore-Auth
        }

        # WHAT ACTUALLY LOGS THE CONSOLE IN. auth_svc.check_permissions()
        # short-circuits on Caldera's own api key for EVERY route:
        #     if self.request_has_valid_api_key(request): return True
        # and get_permissions() grants Access.RED + Access.APP for it. Added
        # AFTER the gate, so only a request CyberCore approved ever carries it,
        # and the browser never sees the value.
        request_header KEY {$CALDERA_API_KEY_RED}

        reverse_proxy {$CALDERA_AUTHORING_UPSTREAM:caldera:8888}
    }
}

# Lane agents use a revocable, lane-scoped capability in the URL. Sandcat 5.3.0
# appends these three paths to -server; it cannot send a custom auth header.
# The authorization subrequest sees the ORIGINAL path before the prefix rewrite.
# Do not enable access logs for /agent/*: the path contains a bearer credential.
(caldera_agent_ingress) {
    log_skip /agent/*
    handle /agent/* {
        route {
            @agent_contact {
                method POST
                path_regexp agent_contact ^/agent/[0-9a-f]{64}/(beacon|file/download|file/upload)$
            }
            handle @agent_contact {
                route {
                    request_header -KEY
                    request_header -Authorization
                    request_header -Cookie
                    request_header -X-CyberCore-*
                    request_header -X-Caldera-*
                    request_header -Remote-*
                    forward_auth app:3000 {
                        uri /api/caldera-agents/authorize
                        copy_headers X-Caldera-Paw X-Caldera-Group
                    }

                    # Payload lookups stay within Caldera's payload directories.
                    # Accept ordinary ability basenames/UUIDs as well as sandcat.go.
                    @bad_payload {
                        path */file/download
                        not header_regexp file ^[A-Za-z0-9][A-Za-z0-9_.-]{0,199}$
                    }
                    respond @bad_payload 400
                    @shared_payload header file shared.go
                    respond @shared_payload 403
                    @bad_agent_platform {
                        header file sandcat.go
                        not header_regexp platform ^(linux|windows)$
                    }
                    respond @bad_agent_platform 400
                    @missing_architecture not header Architecture *
                    request_header @missing_architecture Architecture amd64
                    @bad_agent_architecture {
                        header file sandcat.go
                        not header_regexp architecture ^(amd64|arm64)$
                    }
                    respond @bad_agent_architecture 400

                    uri path_regexp ^/agent/[0-9a-f]{64} ""
                    # Agent tokens never grant console/API credentials. Forward
                    # only Sandcat's fixed request headers; in particular omit
                    # Directory (server payload writes), compile/extension flags,
                    # and all authentication and forwarded identity headers.
                    reverse_proxy {$CALDERA_AUTHORING_UPSTREAM:caldera:8888} {
                        header_up -*
                        header_up Content-Type {http.request.header.Content-Type}
                        header_up File {http.request.header.File}
                        header_up Platform {http.request.header.Platform}
                        header_up Architecture {http.request.header.Architecture}
                        header_up Paw {http.request.header.X-Caldera-Paw}
                        header_up X-Request-Id {http.request.header.X-Caldera-Paw}
                        header_up X-Paw {http.request.header.X-Caldera-Paw}
                        header_up X-Host {http.request.header.X-Host}
                        header_up X-Caldera-Paw {http.request.header.X-Caldera-Paw}
                        header_up X-Caldera-Group {http.request.header.X-Caldera-Group}
                    }
                }
            }
            respond 404
        }
    }
}

# --- Public site (HTTPS via Let's Encrypt when CYBERHUB_HOST is a domain) ----
{$CYBERHUB_HOST} {

    # Guacamole remote console — same-origin proxy so the browser and Guacamole
    # share an origin (satisfies Guacamole's X-Frame-Options: SAMEORIGIN).
    # Caddy upgrades WebSocket connections automatically.
    handle /guacamole* {
        reverse_proxy guacamole:8080
    }

    # Caldera AUTHORING console lives on its own HOSTNAME, not a subpath.
    # magma is a single-page app that requests /api/v2/* and /assets/* from
    # the ORIGIN ROOT, and its bootstrap call GET /api/v2/config/main is how
    # it learns its own config — so no api_base_url setting can move it. A
    # subpath mount therefore cannot work without rewriting Caldera's own
    # traffic. Kept only so existing links do not dead-end.
    redir /caldera* https://{$CALDERA_HOST}/ 302

    handle {
        reverse_proxy app:3000
    }
}

# --- Internal HTTP listener (no TLS, no redirect) ----------------------------
# Catches any direct-IP request on :80 — e.g. lane gateways hitting
# http://100.100.20.50/api/lane-bootstrap, lane web VMs pulling vuln-app images
# from /api/profile-deploy/image/<token>. Same routes as the public site.
#
# `http://` prefix is REQUIRED — without it, Caddy treats this as a site that
# COULD do HTTPS, and the auto-HTTPS engine adds a 308 HTTP→HTTPS redirect on
# behalf of any HTTPS-eligible site (including {$CYBERHUB_HOST}), which then
# bounces lane requests to https://<ip> where the cert doesn't match and the
# lane has no Let's Encrypt root anyway. The explicit `http://` opts this
# block out of auto-HTTPS so it stays a plain HTTP listener.
#
# Reachability of the internal :80 listener is gated at the network layer by
# OPNsense firewall rules (only lab subnets and the orchestrator's own
# interface), so it isn't exposed to the public internet.
#
# NO CALDERA ROUTE HERE, deliberately. The console lives on its own hostname
# (the {$CALDERA_HOST} blocks below) and nothing inside a lane may reach it —
# this listener is exactly what a lane CAN reach.
http://:80 {
    handle /guacamole* {
        reverse_proxy guacamole:8080
    }

    handle {
        reverse_proxy app:3000
    }
}

# =============================================================================
# THE CALDERA AUTHORING CONSOLE — what those two blocks reach, and why
# =============================================================================
# WHAT IS ON THE OTHER END
# A CONTAINER, exactly like guacamole:8080 above. It was a Proxmox VM in an
# earlier revision of this file; that placement is superseded. The authoring
# instance also controls explicitly installed lane agents via its scoped HTTP
# ingress. It is built by infrastructure/caldera/Dockerfile and declared as
# `caldera` in docker-compose.yml.
#
# THE ADDRESS STAYS AN ENVIRONMENT VARIABLE even though the default is now a
# service name, so a deployment that fronts a separate authoring host can
# repoint it without editing this file and this file never carries an address:
#
#     CALDERA_AUTHORING_UPSTREAM=caldera:8888     # the default
#
# It is passed to this container from the `caddy:` service's environment: block
# in docker-compose.yml, next to CYBERHUB_HOST, and to the app as well — the app
# reads it for GET /api/caldera-authoring/status, which is what lets the UI say
# "authoring is not set up" instead of offering a dead link.
#
# THE CONTAINER PUBLISHES NO PORTS. That is the single most important fact about
# it and it is expressed in docker-compose.yml BY AN ABSENT `ports:` KEY, which
# is easy to "helpfully" add — so it carries a comment, and
# front-end/test/caldera-container-config.test.js fails the build if one appears.
# With no port binding the only route to that container is the two handle blocks
# above, both of which run forward_auth first.
#
# LANE AGENTS USE A SEPARATE CAPABILITY GATE. Only the three Sandcat HTTP
# contact endpoints under /agent/<token> reach the central server without an
# instructor session. The app verifies that the token belongs to an active lane;
# Caddy strips the prefix and forwards no console credential. The internal :80
# listener on the main app host still has no direct Caldera route.
#
# THE GATE IS WHAT STOPS THIS BEING OPEN TO THE WORLD
# Without forward_auth, the public block above would publish an adversary
# authoring console on the internet behind nothing but Caldera's own login form
# — one shared, baked, static password, on software whose threat model assumes
# it is on an isolated range. `forward_auth` makes Caddy issue a subrequest to
# the app for every request on this path and forward the original ONLY if that
# subrequest answered 2xx; the app answers 204 for an instructor or admin, 401
# for anonymous, 403 for anyone else, all with an empty body.
#
# READ forward_auth CAREFULLY BEFORE EDITING IT. Three ways to break it silently:
#
#   1. THE STATUS IS THE ENTIRE DECISION. Point `uri` at a path that does not
#      exist and Express answers 404 — non-2xx, so everything is denied and the
#      failure is at least loud. Point it at almost any path that DOES exist
#      unauthenticated (a static file, /api/site-config, a health check) and it
#      answers 200, and then EVERY request is allowed with no error anywhere.
#      The uri below must stay in lockstep with the mount in
#      front-end/src/server.js; test/caldera-authoring-access.test.js asserts
#      the two match.
#   2. copy_headers COPIES FROM THE AUTH RESPONSE ONTO THE PROXIED REQUEST, AND
#      DOES NOT REMOVE THE CLIENT'S OWN COPY — Caddy advisory
#      GHSA-7r4p-vjf4-gxv4, which affects every stable release from v2.10.0 on.
#      So if /api/caldera-authoring/authorize ever answered 2xx WITHOUT setting
#      X-CyberCore-Auth, whatever the BROWSER sent under that name would be
#      forwarded verbatim. Two things stop that, and they are independent:
#
#        - the `request_header -X-CyberCore-Auth` lines above delete the client's
#          value before the gate ever runs, so there is nothing to survive; and
#        - the value is an HMAC-signed token, not a name, so a header a client
#          invents is not a valid token whatever it says. The client does not
#          hold CALDERA_SSO_SECRET.
#
#      An EARLIER REVISION OF THIS FILE said copy_headers was deliberately
#      absent because Caldera had no header-based SSO. It has one now:
#      infrastructure/caldera/login_handler.py, installed by
#      auth.login.handler.module. The one header it trusts is signed,
#      single-use (the jti is burned against POST /api/caldera/redeem, which is
#      why a replay inside the 60-second window still fails) and expires in 60
#      seconds. DO NOT ADD A SECOND, UNSIGNED HEADER next to it.
#   3. DIRECTIVE ORDER IS NOT LINE ORDER — except inside `route`, which is why
#      each /caldera handle above wraps its body in one. Caddy sorts directives
#      in a block by its own default order, and in that order `request_header`
#      comes AFTER `forward_auth`. Unwrap the route and the strip runs last,
#      deleting the token the gate just installed. `route` makes execution order
#      equal written order; leave it. (Outside the route, the same default
#      ordering puts `redir` ahead of the handle blocks, so the bare /caldera →
#      /caldera/ redirect is answered before the gate runs. That is deliberate
#      and costs nothing: it discloses only that the path exists, which a 401
#      discloses anyway, and it carries no session and reaches no upstream.)
#
# CALDERA'S OWN LOGIN, AND THE ATTRIBUTION TRADE-OFF
# There is no second password. infrastructure/caldera/conf/local.yml points
# auth.login.handler.module at the SSO handler, which replaces Caldera's built-in
# username/password comparison outright, and the entrypoint gives every account a
# random password generated per container start that is never printed and never
# stored — so the login form magma still renders is a dead end, not a door.
#
# ATTRIBUTION IS STILL LOST ON THE CALDERA SIDE, for an unchanged reason: Caldera
# groups ('red'/'blue') are a ROLE, not tenancy, with no per-object ownership, so
# there is nothing finer than one account per group to attach an instructor to.
# Accepted: authoring an adversary changes nothing in any lane, and the act that
# does — launching one — is attributed by CyberCore, which records launched_by on
# the run row. Note that the identity IS carried across: the token names the
# CyberCore user id in its `sub` claim, so the handler can log who it admitted
# even though Caldera's own object model cannot record it.
#
# THE APP STILL HOLDS NO CALDERA PASSWORD. It holds a signing key, which is not
# the same thing: a key that mints a 60-second single-use token grants nothing on
# its own and is never sent anywhere — only the token it produces is. Should a
# credential ever have to be supplied server-side, it arrives as a root-owned
# 0600 FILE the way bake-caldera-server.sh delivers every secret it has, never as
# a script_arg.
#
# NOT VERIFIED — THE TWO THINGS TO CHECK FIRST WHEN IT MISBEHAVES
# Nothing in this repository has ever talked to a running Caldera.
#   a. THE SUBPATH. handle_path strips /caldera before proxying, so the upstream
#      sees its own root — but Caldera 5 serves a Vue SPA that emits ROOT-
#      ABSOLUTE URLs (/js/*, /api/v2/*, the login POST). Those come back to
#      Caddy without the prefix and fall through to `handle` → app:3000 → 404.
#      If the login page renders but its assets or its form 404, the fix is a
#      DEDICATED HOSTNAME for the authoring console, not a workaround here: add
#      a third site block whose body is the `route { strip… forward_auth…
#      reverse_proxy… }` from above with no handle_path around it, and point DNS
#      at this Caddy. COPY THE WHOLE ROUTE WITH IT — a hostname is not a gate,
#      and a gate without the header strip is the advisory above with the door
#      already open. front-end/test/caldera-container-config.test.js asserts
#      both PER BLOCK, so a third block that forgets either one fails the suite
#      rather than shipping.
#   b. WEBSOCKETS. Caldera's operation view uses one; Caddy upgrades WebSocket
#      connections automatically, and forward_auth runs on the upgrade request
#      like any other, so an expired session drops the socket rather than
#      leaving it open.
# =============================================================================

# --- Caldera authoring console, on its OWN HOSTNAME --------------------------
# ORIGIN ROOT, NOT A SUBPATH, and that is not a preference. magma is a Vue SPA
# that requests /api/v2/* and /assets/* from the root, and it bootstraps by
# calling GET /api/v2/config/main to learn its own configuration — so it uses
# the default base for the one call that would have told it a different base.
# app.frontend.api_base_url therefore cannot move it, and a subpath mount can
# only be made to work by rewriting Caldera's own traffic. Observed directly:
# under /caldera/ the shell loaded and the SPA then 404'd on
# https://<site>/api/v2/config/main and /api/v2/plugins.
#
# Two blocks, because the tunnel may deliver either scheme: Cloudflare's ingress
# rule points at this container, and whether that is http:// or https:// is a
# dashboard setting. Both carry the identical gate via the snippet.
{$CALDERA_HOST} {
    import caldera_agent_ingress
    handle {
        import caldera_gate
    }
}

http://{$CALDERA_HOST} {
    import caldera_agent_ingress
    handle {
        import caldera_gate
    }
}
